# Environment variables for API keys
# Copy this file to .env and add your actual API keys

# Google Maps API key (optional, for enhanced geocoding and directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService API key (alternative routing service)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Mapbox API key (alternative mapping service)
MAPBOX_API_KEY=your_mapbox_api_key_here
